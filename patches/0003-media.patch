+//! Pictures in a request: what an engine that reads them decodes, and the hooks the server uses to lay them out in a prompt.
+const std = @import("std");
+const Allocator = std.mem.Allocator;
+
+/// A decoded picture: RGB8, rows top to bottom, `width * height * 3` bytes.
+pub const Picture = struct { rgb: []const u8, width: u32, height: u32 };
+
+/// One image or video of a request, as its engine's hooks decoded it. The prompt names its tokens with placeholders;
+/// `runs` (set by the server once the prompt is tokenized) say where, as [start, count) of prompt rows.
+pub const Media = struct {
+    kind: enum { image, video },
+    /// One picture for an image; for a video an even number of frames, two to a tubelet.
+    frames: []const Picture,
+    /// The patch grid every frame is resized to (columns, rows of 16 pixels).
+    cols: u32,
+    rows: u32,
+    /// Prompt tokens the whole item takes, and how many runs they come in (an image: one; a video: one per tubelet).
+    tokens: u32,
+    groups: u32 = 1,
+    /// A video's sampling time of each frame in seconds (empty: unknown).
+    times: []const f32 = &.{},
+    runs: []const [2]u32 = &.{},
+};
+
+pub const MediaSet = struct { items: []Media };
+
+/// What an engine that reads pictures gives the server: decoding, and the prompt text that stands for an item.
+pub const Hooks = struct {
+    ctx: *anyopaque,
+    /// An image file's bytes (JPEG, PNG, BMP or GIF) as a Media; slices are allocated in `a`.
+    image: *const fn (ctx: *anyopaque, a: Allocator, bytes: []const u8) anyerror!Media,
+    /// A video file's bytes as sampled frames.
+    video: *const fn (ctx: *anyopaque, a: Allocator, bytes: []const u8) anyerror!Media,
+    /// The prompt text for an item: `index` of `count` pictures in its message (the labels the chat template wants),
+    /// with the placeholder token spelled out once for every token the item takes.
+    text: *const fn (ctx: *anyopaque, a: Allocator, item: *const Media, index: u32, count: u32) anyerror![]const u8,
+    /// The placeholder's token id, and the ids the server may swap a run's placeholders for so that two pictures of one
+    /// size never share a prompt-cache key (the engine reads positions from `runs`, not ids).
+    placeholder: u32,
+    salt_first: u32,
+    salt_count: u32,
+};
