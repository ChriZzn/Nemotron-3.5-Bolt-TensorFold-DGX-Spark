diff --git a/zig/src/server/media.zig b/zig/src/server/media.zig
new file mode 100644
index 0000000..854abf6
--- /dev/null
+++ b/zig/src/server/media.zig
@@ -0,0 +1,112 @@
+//! Pictures in chat messages. An image_url or video_url part is decoded by the engine's media hooks and replaced, in the
+//! message text, by the prompt text the hooks give for it (placeholder tokens included); the decoded pictures ride with the
+//! request, and once the prompt is tokenized `bind` finds where each picture's tokens sit.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json.zig");
+const errors = @import("errors.zig");
+const Value = json.Value;
+const Cx = errors.Cx;
+
+/// The media of the request being planned; `Cx.media` points at it while its messages are normalized.
+pub const Collector = struct {
+    hooks: api.MediaHooks,
+    items: std.ArrayList(api.Media) = .empty,
+    /// Pictures one request may carry.
+    max_items: usize = 64,
+};
+
+pub fn collector(cx: *Cx) ?*Collector {
+    return if (cx.media) |p| @ptrCast(@alignCast(p)) else null;
+}
+
+pub const Kind = enum { image, video };
+
+/// Whether a content part is a picture: OpenAI's image_url / video_url (and the Responses API's input_image / input_video).
+pub fn kindOf(part: Value) ?Kind {
+    if (part != .object) return null;
+    const t = part.get("type") orelse return null;
+    if (t != .string) return null;
+    if (std.mem.eql(u8, t.string, "image_url") or std.mem.eql(u8, t.string, "input_image") or std.mem.eql(u8, t.string, "image")) return .image;
+    if (std.mem.eql(u8, t.string, "video_url") or std.mem.eql(u8, t.string, "input_video") or std.mem.eql(u8, t.string, "video")) return .video;
+    return null;
+}
+
+/// The part's data URL: {"image_url": {"url": ...}}, {"image_url": "..."} or {"video_url": ...} alike.
+fn urlOf(part: Value, kind: Kind) ?[]const u8 {
+    const key = if (kind == .image) "image_url" else "video_url";
+    const v = part.get(key) orelse part.get(if (kind == .image) "image" else "video") orelse return null;
+    if (v == .string) return v.string;
+    if (v == .object) if (v.get("url")) |u| if (u == .string) return u.string;
+    return null;
+}
+
+/// The bytes of a base64 data URL; remote URLs are refused (a server other machines reach never fetches for its clients).
+fn dataUrl(cx: *Cx, url: []const u8) errors.Refused![]const u8 {
+    if (!std.mem.startsWith(u8, url, "data:")) return cx.refuse("pictures must be sent as base64 data URLs (data:image/png;base64,...); remote URLs are not fetched");
+    const comma = std.mem.indexOfScalar(u8, url, ',') orelse return cx.refuse("a picture's data URL has no payload");
+    if (std.mem.indexOf(u8, url[0..comma], ";base64") == null) return cx.refuse("a picture's data URL must be base64");
+    const payload = url[comma + 1 ..];
+    // tolerate the line breaks some clients put in
+    var clean: std.ArrayList(u8) = .empty;
+    for (payload) |c| if (c != '\n' and c != '\r' and c != ' ') try clean.append(cx.a, c);
+    const dec = std.base64.standard.Decoder;
+    const n = dec.calcSizeForSlice(clean.items) catch return cx.refuse("a picture's base64 payload is invalid");
+    const out = try cx.a.alloc(u8, n);
+    dec.decode(out, clean.items) catch return cx.refuse("a picture's base64 payload is invalid");
+    return out;
+}
+
+/// Decode one picture part, remember it, and append its prompt text. `index` of `count` pictures in the message.
+pub fn append(cx: *Cx, c: *Collector, part: Value, kind: Kind, text: *std.ArrayList(u8), index: u32, count: u32) errors.Refused!void {
+    if (c.items.items.len >= c.max_items) return cx.fail(.request, "a request may carry at most {d} images and videos", .{c.max_items});
+    const url = urlOf(part, kind) orelse return cx.refuse("an image or video part needs a data URL");
+    const bytes = try dataUrl(cx, url);
+    const item = (switch (kind) {
+        .image => c.hooks.image(c.hooks.ctx, cx.a, bytes),
+        .video => c.hooks.video(c.hooks.ctx, cx.a, bytes),
+    }) catch |e| return cx.fail(.request, "the {s} could not be read ({s}); images are JPEG, PNG, BMP or GIF, videos need ffmpeg", .{ @tagName(kind), @errorName(e) });
+    try c.items.append(cx.a, item);
+    const s = c.hooks.text(c.hooks.ctx, cx.a, &c.items.items[c.items.items.len - 1], index, count) catch |e| return cx.fail(.request, "the {s} could not be laid out ({s})", .{ @tagName(kind), @errorName(e) });
+    try text.appendSlice(cx.a, s);
+}
+
+fn mix(x0: u64) u64 {
+    var x = x0 +% 0x9e3779b97f4a7c15;
+    x = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9;
+    x = (x ^ (x >> 27)) *% 0x94d049bb133111eb;
+    return x ^ (x >> 31);
+}
+
+pub const Bound = struct { ids: []const u32, set: *const api.MediaSet };
+
+/// The prompt's placeholder runs, in order, matched to the pictures; the placeholders swapped for ids salted by each
+/// group's pixels so a prompt-cache key names the picture. Refuses a prompt whose placeholders do not fit the pictures
+/// (a client that typed `<image>` itself).
+pub fn bind(cx: *Cx, hooks: api.MediaHooks, items: []const api.Media, ids: []const u32) errors.Refused!Bound {
+    const out = try cx.a.dupe(u32, ids);
+    const set = try cx.a.alloc(api.Media, items.len);
+    var at: usize = 0;
+    for (items, set) |item, *dst| {
+        dst.* = item;
+        const runs = try cx.a.alloc([2]u32, item.groups);
+        const per: u32 = item.tokens / item.groups;
+        var h: u64 = std.hash.Wyhash.hash(0x6d656469, std.mem.asBytes(&.{ item.cols, item.rows, item.tokens }));
+        for (item.frames) |f| h = std.hash.Wyhash.hash(h, f.rgb);
+        for (runs, 0..) |*run, g| {
+            while (at < out.len and out[at] != hooks.placeholder) at += 1;
+            if (at + per > out.len) return cx.refuse("the prompt has fewer image placeholders than its pictures need");
+            for (out[at .. at + per]) |t| if (t != hooks.placeholder) return cx.refuse("the prompt's image placeholders do not match its pictures (do not write <image> in the text)");
+            if (at + per < out.len and out[at + per] == hooks.placeholder) return cx.refuse("the prompt's image placeholders do not match its pictures (do not write <image> in the text)");
+            run.* = .{ @intCast(at), per };
+            for (0..per) |j| out[at + j] = hooks.salt_first + @as(u32, @intCast(mix(h ^ (@as(u64, g) << 40) ^ j) % hooks.salt_count));
+            at += per;
+        }
+        dst.runs = runs;
+    }
+    // placeholders left over mean text the client wrote
+    while (at < out.len) : (at += 1) if (out[at] == hooks.placeholder) return cx.refuse("the prompt has more image placeholders than pictures (do not write <image> in the text)");
+    const holder = try cx.a.create(api.MediaSet);
+    holder.* = .{ .items = set };
+    return .{ .ids = out, .set = holder };
+}
